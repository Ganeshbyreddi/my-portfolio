`;i.f`
  mutation DuplicateFile($duplicateFileInput: DuplicateFileInput!) {
    duplicateFile(input: $duplicateFileInput) {
      # The dashboard splices the copy straight into its cached list, and a
      # row missing any field that list selects makes the whole list read as
      # incomplete. Returning the list's own fragment means the cache gets the
      # server's state rather than values inferred from the source.
      ...HomeFileFields
    }
  }
