  fragment DefaultThemeFontFields on ThemeFont {
    id
    name
    url
  }
`;i.f`
  fragment SourceThemeFields on Theme {
    id
    workspaceId
    name
    headingFont
    headingFontWeight
    bodyFont
    bodyFontWeight
    accentColor
    logoUrl
    config
    priority
    previewUrl
    archived
