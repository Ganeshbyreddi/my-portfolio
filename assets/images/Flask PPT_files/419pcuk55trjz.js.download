      profileImageUrl
      displayName
      id
      email
      deleted
    }
    fileUser {
      id
      lastViewed
      lastEdited
      favorited
    }
    workspace {
      id
      name
      createdTime
      gammaDataProcessingRole
      workspaceSettings {
        workspaceId
        sites
        accessLinks
        searchIndexing
        workspaceGuestInvites
        workspaceSharing
      }
    }
    workspaceAccess
    myPermission
    visibility
    hasFolder
    folder {
      id
      name
      myPermission
    }
    site {
      id
      name
      archived
      enabled
      faviconUrl
      hasCustomDomain
      previewUrl
      domains {
        ...DefaultDomainsFields
      }
    }
    collaborators {
      permission
      fileId
      user {
        id
      }
    }
    accessLinks {
      ...AccessLinkFields
    }
  }
`;i.f`
  mutation DuplicateFile($duplicateFileInput: DuplicateFileInput!) {
    duplicateFile(input: $duplicateFileInput) {
      # The dashboard splices the copy straight into its cached list, and a
      # row missing any field that list selects makes the whole list read as
      # incomplete. Returning the list's own fragment means the cache gets the
      # server's state rather than values inferred from the source.
      ...HomeFileFields
    }
  }
  ${s}
`,i.f`
  ${s}
  query GetFiles(
    $first: Int
    $after: String
    $workspaceId: ID
    $createdBy: ID
    $archived: Boolean
    $sortBy: FileSortOrder
    $isPrivate: Boolean
    $isApiGenerated: Boolean
    $isSite: Boolean
    $isTemplate: Boolean
  ) {
    files(
      first: $first
      after: $after
      workspaceId: $workspaceId
      createdBy: $createdBy
      archived: $archived
      sortBy: $sortBy
      isPrivate: $isPrivate
      isApiGenerated: $isApiGenerated
      isSite: $isSite
      isTemplate: $isTemplate
    ) {
      edges {
        node {
          ...HomeFileFields
        }
      }
      pageInfo {
        endCursor
        hasNextPage
      }
    }
  }
`,i.f`
  ${s}
  query GetSharedFiles(
