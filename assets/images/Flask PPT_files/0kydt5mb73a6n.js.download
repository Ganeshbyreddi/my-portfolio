  query GetWorkspaceGroups(
    $workspaceId: String!
    $sortBy: GroupSortOrder
    $query: String
    $first: Int
    $after: String
  ) {
    groups(
      workspaceId: $workspaceId
      sortBy: $sortBy
      query: $query
      first: $first
      after: $after
    ) {
      edges {
        node {
          id
          name
          source
          memberCount
        }
      }
      pageInfo {
        endCursor
        hasNextPage
      }
    }
  }
`,e6.f`
  query GetGroup($id: ID!) {
    group(id: $id) {
      id
      name
      source
      memberCount
      members {
        id
        userId
        role
        user {
          id
          displayName
          email
          profileImageUrl
        }
      }
    }
  }
`,e6.f`
  query GetGroupFolders($groupId: ID!) {
    groupFolders(groupId: $groupId) {
      id
      name
      permission
    }
  }
`,e6.f`
  query GetGroupFiles($groupId: ID!, $first: Int, $after: String) {
    groupFiles(groupId: $groupId, first: $first, after: $after) {
      nodes {
        id
        title
        mainPageId
        permission
      }
      pageInfo {
        hasNextPage
        endCursor
      }
    }
  }
`,e6.f`
  mutation CreateGroup($input: CreateGroupInput!) {
    createGroup(input: $input) {
      id
      name
      source
      memberCount
    }
  }
`,e6.f`
  mutation AddGroupMembers($input: AddGroupMembersInput!) {
    addGroupMembers(input: $input) {
      id
      memberCount
      members {
        id
        userId
        role
        user {
          id
          displayName
          email
          profileImageUrl
        }
      }
    }
  }
`,e6.f`
  mutation RemoveGroupMembers($input: RemoveGroupMembersInput!) {
    removeGroupMembers(input: $input) {
      id
      memberCount
      members {
        id
        userId
        role
        user {
          id
          displayName
          email
          profileImageUrl
        }
      }
    }
  }
`,e6.f`
  mutation UpdateGroup($input: UpdateGroupInput!) {
    updateGroup(input: $input) {
      id
      name
      source
      members {
        id
        userId
        role
        user {
          id
          displayName
          email
          profileImageUrl
        }
      }
    }
  }
`,e6.f`
  mutation DeleteGroup($id: ID!) {
    deleteGroup(id: $id)
  }
