  fragment PublicApiKeyFields on PublicApiKey {
    id
    name
    maskedKey
    lastUsedTime
    createdTime
  }
`,e8=e6.f`
  ${e9}
  query GetPublicApiKeys($workspaceId: ID!) {
    publicApiKeys(workspaceId: $workspaceId) {
      ...PublicApiKeyFields
    }
  }
`,e7=e6.f`
  ${e9}
  mutation CreatePublicApiKey($input: CreatePublicApiKeyInput!) {
    createPublicApiKey(input: $input) {
      apiKey {
        ...PublicApiKeyFields
      }
      plaintextKey
    }
  }
`,te=e6.f`
  ${e9}
  mutation UpdatePublicApiKey($input: UpdatePublicApiKeyInput!) {
