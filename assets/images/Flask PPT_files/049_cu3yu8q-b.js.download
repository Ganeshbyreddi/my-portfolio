`,z.f`
  ${B}
  mutation RemoveReaction($reactionInput: RemoveReactionInput!) {
    removeReaction(input: $reactionInput) {
      ...ReactionFields
    }
  }
`,z.f`
  query GetMemoAnalytics($memoId: ID!) {
    memoStats(id: $memoId) {
      memoId
      uniqueViewers
      uniqueEditors
      cardCount
      lastOpened
      viewers {
        user {
          id
          displayName
          email
          profileImageUrl
        }
        visitorId
        lastOpened
        cardsViewed
      }
      dailyViews {
        dayCount
        timezone
        everyone {
          date
          uniqueVisitors
        }
        viewers {
          date
          uniqueVisitors
        }
      }
    }
  }

  query GetDocCardsAnalytics($docId: ID!, $userId: ID) {
    docCardsStats(docId: $docId, userId: $userId) {
      docId
      uniqueVisitors
      uniqueEditors
      cardCount
      everyone {
        cardId
        viewTimePercent
        viewersPercent
      }
      viewers {
        cardId
        viewTimePercent
        viewersPercent
      }
    }
  }
`,z.f`
  mutation UpdateSearchEngineIndexing($fileId: ID!, $enable: Boolean!) {
    updateSearchEngineIndexing(fileId: $fileId, enable: $enable) {
      id
      searchEngineIndexingEnabled
    }
  }
