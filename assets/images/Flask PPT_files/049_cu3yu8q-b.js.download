  src: url('${e}/fonts/EudoxusSans-Light.woff2') format('woff2'),
    url('${e}/fonts/EudoxusSans-Light.woff') format('woff');
  font-weight: 300;
  font-style: normal;
  font-display: block;
}
@font-face {
  font-family: 'Eudoxus Sans';
  src: url('${e}/fonts/EudoxusSans-ExtraBold.woff2') format('woff2'),
    url('${e}/fonts/EudoxusSans-ExtraBold.woff') format('woff');
  font-weight: 800;
  font-style: normal;
  font-display: block;
}
@font-face {
  font-family: 'Eudoxus Sans';
  src: url('${e}/fonts/EudoxusSans-ExtraLight.woff2') format('woff2'),
    url('${e}/fonts/EudoxusSans-ExtraLight.woff') format('woff');
  font-weight: 200;
  font-style: normal;
  font-display: block;
}
@font-face {
  font-family: 'Eudoxus Sans';
  src: url('${e}/fonts/EudoxusSans-Medium.woff2') format('woff2'),
    url('${e}/fonts/EudoxusSans-Medium.woff') format('woff');
  font-weight: 500;
  font-style: normal;
  font-display: block;
}
